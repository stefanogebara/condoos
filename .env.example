# CondoOS — copy to .env and fill in

# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=local-dev-jwt-secret-32chars-minimum-ok
# Optional but recommended in prod — separates vendor magic-link rotation
# from admin-session rotation. Required to be >= 32 chars when set.
# Falls back to JWT_SECRET with a warning in prod if unset; random per-
# process in dev.
VENDOR_TOKEN_SECRET=
CORS_ORIGIN=http://localhost:3000
# Set only on disposable demo deployments. Leave both unset in real production.
# In production, DEMO_AUTH_ENABLED is ignored unless ALLOW_DEMO_AUTH_IN_PRODUCTION=1.
DEMO_AUTH_ENABLED=
# Extra explicit override required before demo credentials work in production.
ALLOW_DEMO_AUTH_IN_PRODUCTION=
# Private B2B onboarding. Defaults to required unless NODE_ENV=development/test.
# Set to 0 only for disposable demo/e2e environments.
PRIVATE_CREATE_BUILDING_REQUIRED=
# Optional emergency/bootstrap codes, comma-separated. Prefer DB-backed
# private_setup_codes for real sales tracking and expiry.
PRIVATE_SETUP_CODES=
# Auth limiter: per IP+email cap plus broad per-IP cap, both per 15 minutes.
AUTH_RATE_LIMIT_MAX=5
AUTH_IP_RATE_LIMIT_MAX=60

# Database (SQLite)
DB_PATH=./data/condoos.sqlite

# File uploads (documents, receipts, ticket evidence). If R2 is configured,
# CondoOS uses Cloudflare R2 presigned uploads; otherwise local/dev stores
# files under ./data/uploads.
FILE_STORAGE_DRIVER=
FILE_UPLOAD_MAX_MB=25
LOCAL_UPLOAD_DIR=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# AI — OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_TIMEOUT_MS=20000

# Error monitoring (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# Google sign-in (optional — leave empty to hide the Google button)
# 1. Create OAuth client ID at https://console.cloud.google.com/apis/credentials
# 2. Authorized JS origins: http://localhost:3000, https://condoos-ten.vercel.app
# 3. Paste the client ID below (same value on both server + Vercel env)
GOOGLE_CLIENT_ID=
# Optional: also set VITE_GOOGLE_CLIENT_ID in client-app/.env for Vercel builds

# Client analytics (optional)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Exposes internal prototype pages (/design, /logos) in production builds.
VITE_EXPOSE_INTERNAL_PAGES=

# Invite email delivery (optional). When configured, board admins can email
# roster-import invites through Resend. Password signups also use this channel
# for email confirmation before a user can create a new condo in production.
APP_ORIGIN=http://localhost:3000
EMAIL_PROVIDER=resend
EMAIL_FROM="CondoOS <noreply@example.com>"
RESEND_API_KEY=
EMAIL_VERIFICATION_REQUIRED=

# Cloudflare Turnstile for /onboarding/create-building. The API starts
# requiring captcha automatically when both keys are configured; set
# CREATE_BUILDING_CAPTCHA_REQUIRED=1 in production to fail closed.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CREATE_BUILDING_CAPTCHA_REQUIRED=

# WhatsApp notifications (optional). Default provider is auto-detected.
# Twilio is official but business-initiated messages require approved templates.
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# WAHA is an unofficial WhatsApp Web bridge. Use only with a dedicated session/account.
# WHATSAPP_PROVIDER=waha
# WAHA_URL=https://your-waha-app.fly.dev/api
# WAHA_SESSION=default
# WAHA_API_KEY=

# Production E2E against Vercel Deployment Protection.
# Store the real value in your shell or CI secrets, never in git.
VERCEL_AUTOMATION_BYPASS_SECRET=
# Backward-compatible aliases accepted by playwright.config.ts:
# VERCEL_PROTECTION_BYPASS=
# VERCEL_BYPASS_SECRET=
