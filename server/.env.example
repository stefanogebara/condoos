# CondoOS API - copy to server/.env for server-only local overrides.

PORT=4000
NODE_ENV=development
JWT_SECRET=local-dev-jwt-secret-32chars-minimum-ok
CORS_ORIGIN=http://localhost:3000
# Set only on disposable demo deployments. Leave unset in real production.
DEMO_AUTH_ENABLED=

DB_PATH=./data/condoos.sqlite

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_CHEAP_MODEL=deepseek/deepseek-chat
OPENROUTER_VISION_MODEL=anthropic/claude-3-haiku
OPENROUTER_TIMEOUT_MS=20000
# Enables the tool-using admin agent. Keep off until agent evals pass for the target env.
AGENT_USE_REACT=0

# Optional cited web research for the admin agent.
# Tavily example:
# WEB_SEARCH_PROVIDER=tavily
# WEB_SEARCH_ENDPOINT=https://api.tavily.com/search
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_TIMEOUT_MS=10000

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

GOOGLE_CLIENT_ID=

APP_ORIGIN=http://localhost:3000
EMAIL_PROVIDER=resend
EMAIL_FROM="CondoOS <noreply@example.com>"
RESEND_API_KEY=

# WhatsApp notifications (optional). Default provider is auto-detected.
# Twilio is official but business-initiated messages require approved templates.
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# WAHA is an unofficial WhatsApp Web bridge. Use only with a dedicated session/account.
# WHATSAPP_PROVIDER=waha
# WAHA_URL=https://your-waha-app.fly.dev/api
# WAHA_SESSION=default
# WAHA_API_KEY=
