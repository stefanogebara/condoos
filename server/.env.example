# CondoOS API - copy to server/.env for server-only local overrides.

PORT=4000
NODE_ENV=development
JWT_SECRET=local-dev-jwt-secret-32chars-minimum-ok
# Optional but recommended in prod — separates vendor magic-link rotation
# from admin-session rotation. Required to be >= 32 chars when set; the
# server boot throws if VENDOR_TOKEN_SECRET is present but shorter.
# When unset in production, vendor-tokens falls back to JWT_SECRET (with
# a per-sign warn). In dev, a random per-process value is used.
VENDOR_TOKEN_SECRET=
CORS_ORIGIN=http://localhost:3000
# Set only on disposable demo deployments. Leave unset in real production.
DEMO_AUTH_ENABLED=
# Private B2B onboarding. Defaults to required in NODE_ENV=production.
# Set to 0 only for disposable demo/e2e environments.
PRIVATE_CREATE_BUILDING_REQUIRED=
# Optional emergency/bootstrap codes, comma-separated. Prefer DB-backed
# private_setup_codes for real sales tracking and expiry.
PRIVATE_SETUP_CODES=

DB_PATH=./data/condoos.sqlite

# File uploads. Production should use Cloudflare R2. Local/dev falls back to
# LOCAL_UPLOAD_DIR (default: ./data/uploads) when R2 vars are empty.
FILE_STORAGE_DRIVER=
FILE_UPLOAD_MAX_MB=25
LOCAL_UPLOAD_DIR=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_CHEAP_MODEL=deepseek/deepseek-chat
OPENROUTER_VISION_MODEL=anthropic/claude-3-haiku
OPENROUTER_TIMEOUT_MS=20000
# Enables the tool-using admin agent. Keep off until agent evals pass for the target env.
AGENT_USE_REACT=0

# Optional cited web research for the admin agent.
# Tavily example:
# WEB_SEARCH_PROVIDER=tavily
# WEB_SEARCH_ENDPOINT=https://api.tavily.com/search
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_TIMEOUT_MS=10000

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

GOOGLE_CLIENT_ID=

APP_ORIGIN=http://localhost:3000
EMAIL_PROVIDER=resend
EMAIL_FROM="CondoOS <noreply@example.com>"
RESEND_API_KEY=
EMAIL_VERIFICATION_REQUIRED=

# Cloudflare Turnstile for creating new condos. If TURNSTILE_SECRET_KEY is set,
# the server requires a valid token unless CREATE_BUILDING_CAPTCHA_REQUIRED=0.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CREATE_BUILDING_CAPTCHA_REQUIRED=

# WhatsApp notifications (optional). Default provider is auto-detected.
# Twilio is official but business-initiated messages require approved templates.
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# WAHA is an unofficial WhatsApp Web bridge. Use only with a dedicated session/account.
# WHATSAPP_PROVIDER=waha
# WAHA_URL=https://your-waha-app.fly.dev/api
# WAHA_SESSION=default
# WAHA_API_KEY=
